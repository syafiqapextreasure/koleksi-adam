{
  "name": "koleksi-adam",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-04-01",
  "assets": {
    "directory": ".worker-assets",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/*.html"]
  },
  "kv_namespaces": [{ "binding": "ENQUIRIES" }]
}
